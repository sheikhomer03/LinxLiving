# Copy this file to .env.local and fill in your values.
# See README.md for setup instructions.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/ecommerce-pro
# Optional: custom DNS for mongodb+srv on Windows (comma-separated)
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# -----------------------------------------------------------------------------
# NextAuth.js
# -----------------------------------------------------------------------------
# App URL used for auth callbacks (e.g. http://localhost:3000 in development)
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# -----------------------------------------------------------------------------
# Cloudinary (product image uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=info@linxliving.co.uk

# -----------------------------------------------------------------------------
# AI (Groq — admin product description generation)
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key

# -----------------------------------------------------------------------------
# Public URLs (exposed to the browser)
# -----------------------------------------------------------------------------
# Canonical site URL for SEO (sitemap, robots, metadata)
NEXT_PUBLIC_BASE_URL=https://linxliving.co.uk
# App URL for links in transactional emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

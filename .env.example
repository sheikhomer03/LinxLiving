# Copy this file to .env.local and fill in your values.
# See README.md for setup instructions.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/ecommerce-pro
# Optional: custom DNS for mongodb+srv on Windows (comma-separated)
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# -----------------------------------------------------------------------------
# NextAuth.js
# -----------------------------------------------------------------------------
# App URL used for auth callbacks (e.g. http://localhost:3000 in development)
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# -----------------------------------------------------------------------------
# Cloudinary (product image uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@linxsquare.co.uk

# -----------------------------------------------------------------------------
# AI (Groq — admin product description generation)
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key

# -----------------------------------------------------------------------------
# AI (Claude — customer support chat)
# -----------------------------------------------------------------------------
# Common questions are answered from the pre-defined list in
# src/lib/supportAnswers.ts and never reach the API. Only questions that list
# does not cover are sent to Claude. If this is unset the chat falls back to
# GROQ_API_KEY; if neither is set it hands the customer straight to the team.
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# -----------------------------------------------------------------------------
# Public URLs (exposed to the browser)
# -----------------------------------------------------------------------------
# Canonical site URL for SEO (sitemap, robots, metadata)
NEXT_PUBLIC_BASE_URL=https://linxliving.co.uk
# App URL for links in transactional emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Shopify (commerce backend — Admin + Storefront APIs)
# See SHOPIFY.md for the full setup checklist.
# -----------------------------------------------------------------------------
# Your store hostname, e.g. wnbgk0-xu.myshopify.com (no https://)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Preferred (Dev Dashboard apps, 2026+): Client ID + Secret
# App Settings in https://dev.shopify.com/dashboard → copy Client ID / Client secret
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret

# Legacy only (old admin "custom apps" with a permanent shpat_ token)
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Storefront API token (Admin → Settings → Shopify → Create Storefront token)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional API version pin (default 2025-07)
# SHOPIFY_API_VERSION=2025-07
# Dual-write Mongo products to Shopify on admin create/update/delete (default true when configured)
SHOPIFY_SYNC_ENABLED=true
# When true, public catalog overlays live Shopify price/stock/images onto Mongo products
SHOPIFY_STOREFRONT_ENABLED=true
# Cart → Shopify hosted Checkout (replaces Stripe card path when enabled)
SHOPIFY_CHECKOUT_ENABLED=true
NEXT_PUBLIC_SHOPIFY_CHECKOUT_ENABLED=true
# Auto-pull Shopify → Mongo while admin is open (no manual Pull button needed)
NEXT_PUBLIC_SHOPIFY_AUTO_SYNC=true
# Interval in ms (default 45000)
NEXT_PUBLIC_SHOPIFY_AUTO_SYNC_MS=45000
NOTIFICATION_EMAIL=info@linxsquare.co.uk

# Local development environment template.
# Copy this file to .env.local and populate with your actual keys.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# -----------------------------------------------------------------------------
# NextAuth.js
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# -----------------------------------------------------------------------------
# Stripe (test keys)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# -----------------------------------------------------------------------------
# Cloudinary (product image uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@example.com

# -----------------------------------------------------------------------------
# AI (Groq & Anthropic — admin product description generation)
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# -----------------------------------------------------------------------------
# Public URLs (exposed to the browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Shopify (LinxSquare Connector — Dev Dashboard)
# -----------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=shpss_your_shopify_client_secret
SHOPIFY_SYNC_ENABLED=true
SHOPIFY_STOREFRONT_ENABLED=true
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_shopify_storefront_access_token
SHOPIFY_CHECKOUT_ENABLED=true
NEXT_PUBLIC_SHOPIFY_CHECKOUT_ENABLED=true
SHOPIFY_WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.dev
NEXT_PUBLIC_SHOPIFY_AUTO_SYNC=true
NEXT_PUBLIC_SHOPIFY_AUTO_SYNC_MS=45000
NOTIFICATION_EMAIL=info@example.com

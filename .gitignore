# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Google service-account key used by the product → Sheet sync
google-service-account.json
*-service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch / downloads
/tmp/

.env*.local

# Shopify migration run artefacts — logs, checkpoints and rollback snapshots
# written by scripts/. Useful locally, never part of the source.
scripts/.*
scripts/_tmp-*
rollback-*.json
screenshots/
shopify-*.json
priced-options-not-in-shopify.json

# Supplier documents fetched by scripts/download-product-files.cjs.
# 1.4 GB for Drench alone (largest single PDF 21 MB), so they are served from
# public/ but never committed - GitHub refuses files over 100 MB and the repo
# would grow by more than the whole application. Re-fetch with:
#   SITE=drench node scripts/download-product-files.cjs
public/product-files/
